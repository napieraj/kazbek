# Binaries for programs and plugins
*.exe
*.dll
*.so
*.dylib

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Project-local glide cache, RE: https://github.com/Masterminds/glide/issues/736
.glide/

.vscode

# TLS material is operator-supplied and must never be committed.
# (A real private key was shipped here once; see docker-compose/certificate/README.md.)
docker-compose/certificate/*.key
docker-compose/certificate/*.cer
docker-compose/certificate/*.pem
docker-compose/certificate/*.crt

# TLS material is operator-supplied and must never be committed.
